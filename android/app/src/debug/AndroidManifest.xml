<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the main manifest for debug builds only. Overrides
  networkSecurityConfig to allow cleartext HTTP so you can test against a
  LAN backend before HTTPS is set up. See network_security_config_debug.xml.

  tools:replace is explicit here rather than relying on implicit
  variant-over-main override precedence: the main manifest already sets
  android:networkSecurityConfig on the same <application> element, and I
  can't run the actual manifest merger in this sandbox to confirm implicit
  override behaves the way I expect. tools:replace makes the intent
  unambiguous either way, at zero cost.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
