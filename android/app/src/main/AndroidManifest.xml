<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to your self-hosted backend over the internet or LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Local notification for the daily check-in reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets WorkManager's reminder job survive a device reboot (Phase 1
         schedules it via a BOOT_COMPLETED receiver re-enqueue). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      allowBackup is false, not the usual default true: PrefsRepository's
      DataStore file holds API_SHARED_SECRET in plaintext. allowBackup=true
      with no dataExtractionRules exclusion means that file would be
      eligible for Android's Auto Backup to cloud storage - a bearer token
      controlling access to a paid API silently synced to your Google
      account isn't a great default. Trade-off: reinstalling or restoring to
      a new device means retyping the backend URL and secret once in
      Settings - trivial next to that exposure.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FitCoachPro"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
